<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme for Dark mode. -->
    <style name="Theme.TPSIMobileProjecto" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryVariant">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/stock_green</item>
        <item name="colorSecondaryVariant">@color/stock_green_dark</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">#0F172A</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>